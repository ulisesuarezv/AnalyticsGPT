# =============================================================================
# Copiar a .env.local y rellenar. NUNCA commitear .env.local.
# La columna "Fase" indica a partir de qué fase hace falta la variable.
# =============================================================================

# --- App ------------------------------------------------------------- Fase 0
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- LLM (AI SDK) ----------------------------------------------------- Fase 1
# El modelo es configurable por env: cambiar de proveedor es cambiar el string.
OPENAI_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
LLM_FALLBACK=openai/gpt-4.1-mini

# --- Supabase ---------------------------------------------------- Fases 1 y 3
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Conexión directa a Postgres con el rol `query_runner` (SELECT solo sobre las
# vistas scoped por tenant). Es el ÚNICO canal por el que se ejecuta SQL
# generado por el LLM. Ver docs/ARQUITECTURA.md.
DATABASE_URL_READONLY=

# --- Stripe ----------------------------------------------------------- Fase 5
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_CORE_MONTHLY=
STRIPE_PRICE_CORE_YEARLY=

# --- Shopify ---------------------------------------------- Fase 7 (BLOQUEADA)
# Requiere cuenta Shopify Partners + dev store. Ver docs/ESTADO.md.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
NEXT_PUBLIC_SHOPIFY_SCOPES=read_orders,read_products,read_customers,read_inventory
